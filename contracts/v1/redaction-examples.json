{
  "schema_version": "1.0",
  "policy_version": "redact:1",
  "note": "Synthetic canaries only; none of these values grant access anywhere. Both repositories must run these cases: DMA redacts/withholds, KW detects and refuses to store raw secrets.",
  "cases": [
    {
      "id": "RE-01",
      "raw": "数据库密码: CANARY-PW-7f3a",
      "expected_status": "redacted",
      "expect_kinds": ["password_assignment"],
      "must_not_contain": ["CANARY-PW-7f3a"]
    },
    {
      "id": "RE-02",
      "raw": "调用参数 api_key=sk-CANARY-API-91b2c3d4e5f6g7h8",
      "expected_status": "redacted",
      "expect_kinds": ["api_key"],
      "must_not_contain": ["CANARY-API-91b2c3d4e5f6g7h8"]
    },
    {
      "id": "RE-03",
      "raw": "-----BEGIN PRIVATE KEY-----\nMIIBCgKCAQEA CANARY-PRIVATE-KEY-SYNTHETIC\n-----END PRIVATE KEY-----",
      "expected_status": "withheld",
      "expect_kinds": ["private_key"],
      "must_not_contain": ["CANARY-PRIVATE-KEY-SYNTHETIC"]
    },
    {
      "id": "RE-04",
      "raw": "备份地址 https://backup:CANARY-URL-PASS-123@nas.example.invalid/share",
      "expected_status": "redacted",
      "expect_kinds": ["url_userinfo"],
      "must_not_contain": ["CANARY-URL-PASS-123"]
    },
    {
      "id": "RE-05",
      "raw": "回调 https://example.invalid/cb?token=CANARY-TOKEN-abc123&state=ok",
      "expected_status": "redacted",
      "expect_kinds": ["url_query_token"],
      "must_not_contain": ["CANARY-TOKEN-abc123"]
    },
    {
      "id": "RE-06",
      "raw": "普通工作记录：松塔项目端口改为4200，周备份保持不变。",
      "expected_status": "passed",
      "expect_kinds": [],
      "must_not_contain": []
    },
    {
      "id": "RE-07",
      "raw": "Authorization: Bearer CANARY-BEARER-aaaaaaaaaaaaaaaa",
      "expected_status": "redacted",
      "expect_kinds": ["bearer_token"],
      "must_not_contain": ["CANARY-BEARER-aaaaaaaaaaaaaaaa"]
    },
    {
      "id": "RE-08",
      "raw": "Cookie: session=CANARY-COOKIE-1234567890; path=/",
      "expected_status": "redacted",
      "expect_kinds": ["cookie_header"],
      "must_not_contain": ["CANARY-COOKIE-1234567890"]
    },
    {
      "id": "RE-09",
      "raw": "AWS 凭据 AKIAIOSFODNN7EXAMPLE 需要轮换",
      "expected_status": "redacted",
      "expect_kinds": ["aws_access_key"],
      "must_not_contain": ["AKIAIOSFODNN7EXAMPLE"]
    },
    {
      "id": "RE-10",
      "raw": "令牌 eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJjYW5hcnkifQ.dGVzdC1zaWduYXR1cmU",
      "expected_status": "redacted",
      "expect_kinds": ["jwt"],
      "must_not_contain": ["eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJjYW5hcnkifQ.dGVzdC1zaWduYXR1cmU"]
    }
  ]
}
